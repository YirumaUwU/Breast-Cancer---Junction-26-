# Copy to .env to switch on live AI drafting. The key stays on the server
# (Vite dev/preview middleware); it is never sent to the browser.
ANTHROPIC_API_KEY=
# Optional: override the drafting model.
# KAARI_MODEL=claude-opus-5-5
# Only if the key is not scoped to one workspace (the API then asks for this header).
# ANTHROPIC_WORKSPACE_ID=
